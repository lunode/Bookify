@uri = http://localhost:5062/api

### Register User
POST {{uri}}/users/register
Content-Type: application/json

{
  "email": "user@test.com",
  "firstName": "user",
  "lastName": "test",
  "password": "12345"
}

### LogIn User
POST {{uri}}/users/login
Content-Type: application/json

{
  "email": "user@test.com",
  "password": "12345"
}
